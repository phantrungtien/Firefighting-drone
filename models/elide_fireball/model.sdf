<?xml version="1.0" ?>
<!--
  Quả cầu chữa cháy Elide Fire Ball (số liệu sản phẩm thật)
    đường kính 150 mm, khối lượng 1.3 kg, kích hoạt 3-5 s sau khi chạm lửa.

  Lực cản dùng Hydrodynamics chứ KHÔNG dùng LiftDrag: LiftDrag tính lực theo
  góc tấn (đúng cho cánh), còn hình cầu có lực cản đẳng hướng. Hydrodynamics
  cho lực F = xUabsU * u * |u| trên từng trục -> đúng dạng cản bậc hai.

    xUabsU = -0.5 * rho * Cd * A
           = -0.5 * 1.225 * 0.47 * 0.01767 = -0.005087

  Hệ quả (nghiệm giải tích v_t = sqrt(g/k), k = rho*Cd*A/(2m) = 0.003913):
    tốc độ rơi tới hạn  v_t = 50.1 m/s
    thả từ  25 m -> t = 2.295 s, chạm đất 21.1 m/s
    thả từ 150 m -> t = 6.08 s,  chạm đất 41.6 m/s  (không cản: 54.2 m/s)
  Mốc 150 m là phép thử phân biệt được có cản hay không; mốc 25 m thì không.
-->
<sdf version="1.9">
  <model name="elide_fireball">
    <link name="ball">
      <inertial>
        <mass>1.3</mass>
        <!-- cầu đặc: I = 2/5 m r^2 = 0.4 * 1.3 * 0.075^2 -->
        <inertia>
          <ixx>0.002925</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002925</iyy>
          <iyz>0</iyz>
          <izz>0.002925</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere><radius>0.075</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
          </friction>
          <bounce>
            <!-- vỏ xốp phủ bột: nảy rất ít, gần như dính đất -->
            <restitution_coefficient>0.12</restitution_coefficient>
            <threshold>0.5</threshold>
          </bounce>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere><radius>0.075</radius></sphere>
        </geometry>
        <material>
          <ambient>0.75 0.08 0.06 1</ambient>
          <diffuse>0.85 0.10 0.08 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- vạch trắng quanh xích đạo: dễ nhìn quỹ đạo rơi/xoay khi quay video -->
      <visual name="band">
        <geometry>
          <cylinder><radius>0.0755</radius><length>0.022</length></cylinder>
        </geometry>
        <material>
          <ambient>0.92 0.92 0.90 1</ambient>
          <diffuse>0.96 0.96 0.94 1</diffuse>
        </material>
      </visual>

      <!-- phát hiện chạm đất chính xác thay vì suy đoán từ toạ độ z -->
      <sensor name="impact" type="contact">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>
    </link>

    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>ball</link_name>
      <!-- cản bậc hai đẳng hướng; không có added mass (khối lượng nước kèm)
           vì môi trường là không khí, mass kèm không đáng kể -->
      <xUabsU>-0.005087</xUabsU>
      <yVabsV>-0.005087</yVabsV>
      <zWabsW>-0.005087</zWabsW>
      <!-- ponytail: bỏ cản quay (kPabsP...), quả cầu tròn xoay không ảnh
           hưởng quỹ đạo tâm khối. Thêm khi cần mô phỏng hiệu ứng Magnus. -->
    </plugin>

    <!-- vị trí thật: dùng để chấm CEP và để chẩn đoán khi cơ cấu thả hỏng -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
