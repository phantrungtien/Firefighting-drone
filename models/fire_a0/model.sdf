<?xml version="1.0" ?>
<!--
  Tờ ảnh lửa in khổ A0 1189 x 841 mm - đúng tờ sẽ trải dưới đất cho drone thật thả bóng
  (26/10/2026). Ảnh = ảnh nhúng trong ~/jetson/fire_a0.pdf (3840x2715), co về 2048 rộng:
  ở 5 m tờ giấy chỉ chiếm ~330 px của khung 1920, 2048 là thừa.

  TỰ PHÁT SÁNG (emissive_map = chính ảnh): camera sim không tự chỉnh phơi sáng, chỉ albedo thì
  tờ giấy ra tối hơn ảnh gốc ~2.4 lần (đo 26/10/2026: kênh đỏ TB 62 vs 146) và YOLO lửa của
  Jetson không ra hộp nào kể cả ngưỡng 0.05; sáng bằng ảnh gốc thì ra đúng tờ giấy, 0.52.
  Ngoài nắng + camera tự phơi sáng thì giấy in ra gần ảnh gốc - emissive là để giống CÁI ĐÓ.
  Không có mã ArUco - chỉ YOLO lửa (run_gui.py, ANH_A0=1 trong run_sim.sh) mới thấy được nó.

  Chỉ có visual, không collision: bóng rơi trúng đất ngay bên dưới.
  z = 0.05: trên ground_patch (0.03), tránh nhấp nháy.
-->
<sdf version="1.9">
  <model name="fire_a0">
    <static>true</static>
    <link name="link">
      <visual name="paper">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>1.189 0.841</size></plane></geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>1 1 1 1</emissive>
          <pbr><metal>
            <albedo_map>model://fire_a0/materials/textures/fire_a0.jpg</albedo_map>
            <emissive_map>model://fire_a0/materials/textures/fire_a0.jpg</emissive_map>
            <metalness>0</metalness>
            <roughness>1</roughness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
