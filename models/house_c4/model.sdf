<?xml version="1.0" ?>
<!--
  Nhà cấp 4 mái bằng 12 x 8 m, cao 4 m (thử 18/10/2026: ground_range đo mái hay đo cỏ?).
  Mái lát gạch lá nem (scripts/gen_ground_patch.py -> roof.jpg), tường chắn mái 0.4 m,
  bồn nước inox ở góc - như nhà cấp 4 thật. Có collision: bóng rơi xuống nằm lại trên mái.
  Mái cao 4.00 m, vân 4.02 m, mã ArUco (world) 4.07 m - cách nhau vài cm để khỏi chớp hình.
-->
<sdf version="1.9">
  <model name="house_c4">
    <static>true</static>
    <link name="link">
      <collision name="c">
        <pose>0 0 2 0 0 0</pose>
        <geometry><box><size>12 8 4</size></box></geometry>
      </collision>
      <visual name="walls">
        <pose>0 0 2 0 0 0</pose>
        <geometry><box><size>12 8 4</size></box></geometry>
        <material><ambient>0.85 0.8 0.65 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material>
      </visual>
      <visual name="roof">
        <pose>0 0 4.02 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>12 8</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://house_c4/materials/textures/roof.jpg</albedo_map>
            <metalness>0</metalness>
            <roughness>1</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="para_n_c">
        <pose>0 3.925 4.2 0 0 0</pose>
        <geometry><box><size>12 0.15 0.4</size></box></geometry>
      </collision>
      <visual name="para_n">
        <pose>0 3.925 4.2 0 0 0</pose>
        <geometry><box><size>12 0.15 0.4</size></box></geometry>
        <material><ambient>0.72 0.7 0.62 1</ambient><diffuse>0.78 0.75 0.66 1</diffuse></material>
      </visual>
      <collision name="para_s_c">
        <pose>0 -3.925 4.2 0 0 0</pose>
        <geometry><box><size>12 0.15 0.4</size></box></geometry>
      </collision>
      <visual name="para_s">
        <pose>0 -3.925 4.2 0 0 0</pose>
        <geometry><box><size>12 0.15 0.4</size></box></geometry>
        <material><ambient>0.72 0.7 0.62 1</ambient><diffuse>0.78 0.75 0.66 1</diffuse></material>
      </visual>
      <collision name="para_e_c">
        <pose>5.925 0 4.2 0 0 0</pose>
        <geometry><box><size>0.15 8 0.4</size></box></geometry>
      </collision>
      <visual name="para_e">
        <pose>5.925 0 4.2 0 0 0</pose>
        <geometry><box><size>0.15 8 0.4</size></box></geometry>
        <material><ambient>0.72 0.7 0.62 1</ambient><diffuse>0.78 0.75 0.66 1</diffuse></material>
      </visual>
      <collision name="para_w_c">
        <pose>-5.925 0 4.2 0 0 0</pose>
        <geometry><box><size>0.15 8 0.4</size></box></geometry>
      </collision>
      <visual name="para_w">
        <pose>-5.925 0 4.2 0 0 0</pose>
        <geometry><box><size>0.15 8 0.4</size></box></geometry>
        <material><ambient>0.72 0.7 0.62 1</ambient><diffuse>0.78 0.75 0.66 1</diffuse></material>
      </visual>
      <!-- bồn nước inox đứng 1500 L trên chân sắt, góc đông bắc mái -->
      <collision name="tank_c">
        <pose>4.9 2.9 4.95 0 0 0</pose>
        <geometry><cylinder><radius>0.55</radius><length>1.3</length></cylinder></geometry>
      </collision>
      <visual name="tank">
        <pose>4.9 2.9 4.95 0 0 0</pose>
        <geometry><cylinder><radius>0.55</radius><length>1.3</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.76 0.78 1</ambient><diffuse>0.8 0.81 0.83 1</diffuse>
          <pbr><metal><metalness>0.9</metalness><roughness>0.35</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="tank_stand">
        <pose>4.9 2.9 4.15 0 0 0</pose>
        <geometry><box><size>1.1 1.1 0.3</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
