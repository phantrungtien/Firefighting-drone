<?xml version="1.0" ?>
<!--
  Quả cầu chữa cháy loại NHỎ: đường kính 110 mm, khối lượng 0.5 kg.
  (Elide Fire Ball tiêu chuẩn là 150 mm / 1.3 kg -> models/elide_fireball.)

  Cùng cách mô hình lực cản với bản Elide - Hydrodynamics, cản bậc hai đẳng
  hướng, KHÔNG dùng LiftDrag. Chỉ có ba con số đổi theo r và m:

    A       = pi * 0.055^2                        = 0.009503 m2
    xUabsU  = -0.5 * 1.225 * 0.47 * 0.009503      = -0.002736
    I       = 2/5 * 0.5 * 0.055^2                 = 6.05e-4

  ĐIỀU NGƯỢC VỚI TRỰC GIÁC: quả NHẸ hơn lại rơi CHẬM hơn chứ không nhanh hơn.
  k = rho*Cd*A/(2m) tăng khi m giảm nhanh hơn A, nên tốc độ tới hạn TỤT:

                        v_t      thả 25 m            thả 150 m
    Elide 1.3 kg      50.1 m/s   2.295 s, 21.1 m/s   6.084 s, 41.6 m/s
    loại này 0.5 kg   42.3 m/s   2.309 s, 20.7 m/s   6.308 s, 38.0 m/s

  Ở 25 m hai loại lệch nhau 14 ms và 0.4 m/s - lực cản gần như chưa kịp có ý
  kiến, nên ĐỪNG kỳ vọng đổi bóng là đổi được điểm rơi. Muốn thấy khác biệt
  thật thì phải thả từ trên 100 m.

  ⚠ ballistics.py, mission_node và smoke_test.py VẪN đang mang số của quả
  Elide 1.3 kg. Model này hiện chỉ dùng cho phép đo ga treo
  (scripts/fly_hover.py, tuỳ chọn ball = fireball_05kg). Muốn đổi hẳn sang
  loại 0.5 kg
  thì phải sửa cả ba chỗ đó, nếu không lời giải thả sẽ tính cho quả sai.
-->
<sdf version="1.9">
  <model name="fireball_05kg">
    <link name="ball">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>6.05e-4</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.05e-4</iyy>
          <iyz>0</iyz>
          <izz>6.05e-4</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere><radius>0.055</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.12</restitution_coefficient>
            <threshold>0.5</threshold>
          </bounce>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere><radius>0.055</radius></sphere>
        </geometry>
        <material>
          <ambient>0.75 0.08 0.06 1</ambient>
          <diffuse>0.85 0.10 0.08 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <visual name="band">
        <geometry>
          <cylinder><radius>0.0555</radius><length>0.016</length></cylinder>
        </geometry>
        <material>
          <ambient>0.92 0.92 0.90 1</ambient>
          <diffuse>0.96 0.96 0.94 1</diffuse>
        </material>
      </visual>

      <sensor name="impact" type="contact">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>
    </link>

    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>ball</link_name>
      <xUabsU>-0.002736</xUabsU>
      <yVabsV>-0.002736</yVabsV>
      <zWabsW>-0.002736</zWabsW>
    </plugin>

    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
