<?xml version="1.0"?>
<model>
  <name>fireball_05kg</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Quả cầu chữa cháy 110 mm / 0.5 kg - bản nhỏ của elide_fireball (150 mm /
